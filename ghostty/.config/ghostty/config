theme = Catppuccin Mocha
# theme = Black Metal (Bathory)

font-size = 14

background-opacity = 0.84
background-blur-radius = 40
macos-titlebar-style = hidden
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

window-width = 110
window-height = 30

# Auto-install Ghostty's terminfo entry on SSH hosts that lack it, avoiding
# the TERM=xterm-ghostty mismatch that garbles zsh-syntax-highlighting redraws
shell-integration-features = ssh-env,ssh-terminfo

mouse-hide-while-typing = true
keybind = shift+enter=text:\x1b\r
# Left Option sends Alt/Meta (tmux's no-prefix Alt-bindings); right Option
# keeps producing accented characters.
macos-option-as-alt = left
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 6
cursor-color = #7f849c
